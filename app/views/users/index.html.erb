<p style="color: green"><%= notice %></p>

<h1>ユーザー一覧</h1>

<div id="users" class="index-items">
  <% @users.each do |user| %>
    <div class="index-item">
      <%= render user %>
      <p>
        <%= link_to '詳細', user_path(user) %>
      </p>
    </div>
  <% end %>
</div>

<%= paginate @users %>
